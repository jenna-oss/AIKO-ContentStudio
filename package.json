{
  "name": "aiko-content-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AIKO Content Studio: plan, make and post short educational videos, with the research behind them.",
  "scripts": {
    "pull": "node tools/pull.mjs",
    "merge": "node tools/merge.mjs",
    "daily": "node tools/pull.mjs && node tools/merge.mjs && node tools/to-sql.mjs",
    "kb": "node tools/kb-ingest.mjs && node tools/kb-process.mjs",
    "kb:ingest": "node tools/kb-ingest.mjs",
    "kb:process": "node tools/kb-process.mjs",
    "kb:mirror": "node tools/kb-mirror-published.mjs",
    "kb:mirror-videos": "node tools/kb-mirror-videos.mjs",
    "kb:summarise": "node tools/kb-summarise.mjs",
    "kb:seed-hooks": "node tools/kb-seed-hooks.mjs",
    "test": "node tests/worker.test.mjs"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
